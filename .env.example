# Copy to .env (git-ignored).

# --- Multipass portal, for `wizz-finder search --portal` ---------------------
# Your Multipass subscription id. `wizz-finder login` writes this for you.
# It is the last part of the portal's .../json/availability/<id> request URL.
WIZZ_SUBSCRIPTION_ID=

# Optional. Leave both blank to log in by hand once with `wizz-finder login`;
# the saved browser profile keeps you logged in afterwards.
WIZZ_EMAIL=
WIZZ_PASSWORD=

# --- Fare sources for the non-Wizz legs --------------------------------------
# Ryanair needs no key and is always on. These two widen the search to other
# airlines; whichever you fill in is picked up automatically.

# Kiwi.com Tequila (https://tequila.kiwi.com) - the widest low-cost coverage.
KIWI_API_KEY=

# Amadeus Self-Service (https://developers.amadeus.com) - free tier.
# The test host carries sample data only; set AMADEUS_ENV=production for real fares.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
