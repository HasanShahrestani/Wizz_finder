# Copy to .env (git-ignored). Only needed for `wizz-finder search --portal`.
# Leave email/password empty to log in once by hand with `wizz-finder login` instead.
WIZZ_EMAIL=
WIZZ_PASSWORD=
# Optional: found automatically after login; otherwise copy from the portal's
# .../json/availability/<id> request (wizz-finder record-portal prints it).
WIZZ_SUBSCRIPTION_ID=
