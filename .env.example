# Copy to .env (git-ignored). Only needed for `wizz-finder search --portal`.

# Your Multipass subscription id. `wizz-finder login` writes this for you.
# It is the last part of the portal's .../json/availability/<id> request URL.
WIZZ_SUBSCRIPTION_ID=

# Optional. Leave both blank to log in by hand once with `wizz-finder login`;
# the saved browser profile keeps you logged in afterwards.
WIZZ_EMAIL=
WIZZ_PASSWORD=
